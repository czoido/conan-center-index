Remove deprecated AGL.framework references from macOS mkspec.

AGL.framework was deprecated in macOS 10.9 and removed entirely from the
macOS 26 (Tahoe) SDK. Qt 5.15's qtbase mkspec still references AGL in
QMAKE_INCDIR_OPENGL and QMAKE_LIBS_OPENGL, which makes qmake's OpenGL
feature test fail with newer SDKs because the include path no longer
exists. Qt itself no longer uses AGL at runtime on macOS (it relies on
NSOpenGL and the OpenGL.framework), so the references are vestigial.

--- a/mkspecs/common/mac.conf
+++ b/mkspecs/common/mac.conf
@@ -18,8 +18,7 @@

 # sdk.prf will prefix the proper SDK sysroot
 QMAKE_INCDIR_OPENGL     = \
-    /System/Library/Frameworks/OpenGL.framework/Headers \
-    /System/Library/Frameworks/AGL.framework/Headers/
+    /System/Library/Frameworks/OpenGL.framework/Headers

 QMAKE_FIX_RPATH         = install_name_tool -id

@@ -30,7 +29,7 @@
 QMAKE_REL_RPATH_BASE    = @loader_path

 QMAKE_LIBS_DYNLOAD      =
-QMAKE_LIBS_OPENGL       = -framework OpenGL -framework AGL
+QMAKE_LIBS_OPENGL       = -framework OpenGL
 QMAKE_LIBS_THREAD       =

 QMAKE_INCDIR_WAYLAND    =
